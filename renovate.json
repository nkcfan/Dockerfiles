{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "github-actions"],
  "automerge": false,
  "ignoreUnstable": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^caddy\\/Dockerfile$/"],
      "matchStrings": [
        "(?:^|\\n)ARG CADDY_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "caddy",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^caddy\\/Dockerfile$/"],
      "matchStrings": [
        "(?:^|\\n)ARG DYNU_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "caddy-dns/dynu",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["caddy"],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "matchPackageNames": ["caddy-dns/dynu"],
      "allowedVersions": "/^v[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "matchPackageNames": ["caddy", "caddy-dns/dynu"],
      "groupName": "Caddy runtime dependencies"
    }
  ]
}
