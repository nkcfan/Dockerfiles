{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "github-actions", "git-submodules"],
  "git-submodules": {
    "enabled": true
  },
  "automerge": true,
  "ignoreUnstable": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^caddy\\/Dockerfile$/"],
      "matchStrings": [
        "(?:^|\\n)ARG DYNU_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "caddy-dns/dynu",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/lazydocker\\.yml$/"],
      "matchStrings": [
        "(?:^|\\n)[ \\t]+LAZYDOCKER_VERSION:[ \\t]+(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "jesseduffield/lazydocker",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["caddy-dns/dynu"],
      "allowedVersions": "/^v[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "matchPackageNames": ["caddy-dns/dynu"],
      "groupName": "Caddy runtime dependencies"
    },
    {
      "matchPackageNames": ["jesseduffield/lazydocker"],
      "allowedVersions": "/^v[0-9]+\\.[0-9]+\\.[0-9]+$/"
    }
  ]
}
